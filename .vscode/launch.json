{
    "version": "0.2.0",
    "inputs": [
        {
            "id": "hertzExecutable",
            "type": "command",
            "command": "cmake.launchTargetPath",
            "args": { "targetName": "HertZ_Standalone" }
        }
    ],
    "configurations": [
        {
            "name": "HertZ: Build and Debug (Windows)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${input:hertzExecutable}",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "integratedTerminal"
        },
        {
            "name": "HertZ: Build and Debug (macOS)",
            "type": "lldb",
            "request": "launch",
            "program": "${input:hertzExecutable}",
            "cwd": "${workspaceFolder}",
            "terminal": "console"
        }
    ]
}
